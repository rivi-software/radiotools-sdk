{
  "name": "@rivi-software/radiotools-contract",
  "version": "0.4.0",
  "description": "RadioTools listener API contract (manifest and GraphQL schema)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./graphql": "./graphql/schema.graphql"
  },
  "files": [
    "dist",
    "graphql"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rivi-software/radiotools-sdk.git",
    "directory": "packages/contract"
  }
}
