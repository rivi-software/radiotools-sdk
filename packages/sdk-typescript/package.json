{
  "name": "@rivi-software/radiotools-sdk",
  "version": "0.4.1",
  "description": "Customer SDK for radio stations. Published listener reads and playback ingest only.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
