{
  "name": "@rivi-software/radiotools-sdk-react",
  "version": "0.4.1",
  "description": "React hooks for @rivi-software/radiotools-sdk (generated from @rivi-software/radiotools-contract)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
