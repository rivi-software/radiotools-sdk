    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@rivi-software/radiotools-sdk": "^0.4.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rivi-software/radiotools-sdk.git",
    "directory": "packages/sdk-react"
  }
