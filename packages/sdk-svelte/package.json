{
  "name": "@rivi-software/radiotools-sdk-svelte",
  "version": "0.9.0",
  "description": "Svelte stores for @rivi-software/radiotools-sdk (generated from @rivi-software/radiotools-contract)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@rivi-software/radiotools-sdk": "^0.9.0"
  },
  "peerDependencies": {
    "svelte": ">=4"
  },
  "devDependencies": {
    "svelte": "5.57.2",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rivi-software/radiotools-sdk.git",
    "directory": "packages/sdk-svelte"
  }
}
