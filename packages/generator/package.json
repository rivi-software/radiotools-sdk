{
  "name": "@rivi-software/radiotools-sdk-generator",
  "version": "0.8.1",
  "description": "Generate RadioTools SDKs for multiple frameworks from @rivi-software/radiotools-contract",
  "license": "MIT",
  "type": "module",
  "bin": {
    "radiotools-sdk-generate": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "check": "tsc --noEmit",
    "generate": "bun src/cli.ts generate --target all",
    "list-targets": "bun src/cli.ts list"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rivi-software/radiotools-sdk.git",
    "directory": "packages/generator"
  },
  "dependencies": {
    "@rivi-software/radiotools-contract": "^0.8.1",
    "@rivi-software/radiotools-sdk": "^0.8.1",
    "zod": "4.6.7"
  }
}
