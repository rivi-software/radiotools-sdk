{
  "name": "@rivi-software/radiotools-sdk-vue",
  "version": "0.9.0",
  "description": "Vue composables for @rivi-software/radiotools-sdk (generated from @rivi-software/radiotools-contract)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@rivi-software/radiotools-sdk": "^0.9.0"
  },
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vue": "3.5.43"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rivi-software/radiotools-sdk.git",
    "directory": "packages/sdk-vue"
  }
}
